# ─────────────────────────────────────────────────────────────── required ──

# Where the Vowcraft application lives. Every "Open the app", "Log in", and
# "Sign up" destination is derived from this, so a single value moves the whole
# site between local, staging, and production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# This site's own canonical origin, used for metadata, Open Graph, and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ───────────────────────────────────────────────────────────── optional ──

# Authentication lives entirely in the application. The header's "Log in" and
# "Sign up" links resolve to ${NEXT_PUBLIC_APP_URL}/login and /signup, so this
# site never receives a password and has nothing to configure for auth.

# Contact form delivery. Unset means submissions are validated and logged only,
# and the UI says so rather than implying an email went out.
CONTACT_FORWARD_URL=""
CONTACT_TO_EMAIL="hello@vowcraft.example"
